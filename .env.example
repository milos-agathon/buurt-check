BUURT_ANDROID_KEY_ORGANIZATION=Buurt Check
BUURT_ANDROID_KEY_COUNTRY=NL
BUURT_ANDROID_SKIP_PWA_VALIDATION=false
BUURT_ANDROID_SKIP_SIGNING=false
BUURT_IOS_BUNDLE_ID=nl.buurtcheck.app.ios
