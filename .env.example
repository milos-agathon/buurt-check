BUURT_SENTRY_DSN=
BUURT_SENTRY_ENVIRONMENT=dev
BUURT_METRICS_ENABLED=false
BUURT_METRICS_TOKEN=
BUURT_BASE_URL=https://app.buurt-check.nl
BUURT_STRIPE_SECRET_KEY=
BUURT_STRIPE_WEBHOOK_SECRET=
BUURT_STRIPE_PRICE_CENTS=399
BUURT_GOOGLE_PLAY_ENABLED=false
BUURT_GOOGLE_PLAY_PACKAGE_NAME=nl.buurtcheck.app
BUURT_GOOGLE_PLAY_PRODUCT_ID=full_dossier_unlock
BUURT_GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
BUURT_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
BUURT_APPLE_ENABLED=false
BUURT_APPLE_BUNDLE_ID=nl.buurtcheck.app.ios
BUURT_APPLE_PRODUCT_ID=full_dossier_unlock
BUURT_APPLE_ENVIRONMENT=production
BUURT_APPLE_ISSUER_ID=
BUURT_APPLE_KEY_ID=
BUURT_APPLE_PRIVATE_KEY_FILE=
BUURT_APPLE_PRIVATE_KEY_PEM=
BUURT_APPLE_APP_STORE_ID=
BUURT_ANDROID_ASSET_ORIGIN=
BUURT_ANDROID_VERSION_CODE=1
BUURT_ANDROID_VERSION_NAME=1
BUURT_ANDROID_KEYSTORE_PATH=./android/android-upload-key.jks
BUURT_ANDROID_KEY_ALIAS=upload
