BUURT_IOS_BUILD_NUMBER=1
BUURT_IOS_TEAM_ID=TODO_SET_TEAM_ID

# Frontend (Vite)
# Hosted web builds must keep this at `/api` so Stripe return flows stay
# first-party and the anonymous buyer cookie survives the redirect.
VITE_API_BASE=/api
VITE_ADDRESS_FALLBACK_API_BASE=https://buurt-check.onrender.com/api
# Use the same GA4 web stream ID on both the landing site and the app host.
VITE_GA_MEASUREMENT_ID=
BUURTCHECK_GA_MEASUREMENT_ID=
VITE_APPLE_PRODUCT_ID=full_dossier_unlock
VITE_GOOGLE_PLAY_PRODUCT_ID=full_dossier_unlock
VITE_PLAY_PACKAGE_NAME=nl.buurtcheck.app
VITE_PLAY_SHA256_CERT_FINGERPRINTS=TODO_SET_SHA256_CERT_FINGERPRINT
VITE_PREVIEW_DISABLE_PAYMENTS=false
VITE_PREVIEW_FORCE_FULL_DOSSIER_VIEW=false
