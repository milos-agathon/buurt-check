# Stripe / monetization
BUURT_STRIPE_SECRET_KEY=
BUURT_STRIPE_WEBHOOK_SECRET=
BUURT_STRIPE_PRICE_CENTS=399
BUURT_BASE_URL=https://app.buurt-check.nl

# Apple App Store
BUURT_APPLE_ENABLED=false
BUURT_APPLE_BUNDLE_ID=nl.buurtcheck.app.ios
BUURT_APPLE_PRODUCT_ID=full_dossier_unlock
BUURT_APPLE_ENVIRONMENT=production
BUURT_APPLE_ISSUER_ID=
BUURT_APPLE_KEY_ID=
BUURT_APPLE_PRIVATE_KEY_FILE=
BUURT_APPLE_PRIVATE_KEY_PEM=
BUURT_APPLE_APP_STORE_ID=

# Persistence / observability
BUURT_DATABASE_PATH=buurt_check.db
BUURT_SENTRY_DSN=
BUURT_SENTRY_ENVIRONMENT=dev

# Local webhook forwarding:
# stripe listen --forward-to localhost:8000/api/billing/webhook

