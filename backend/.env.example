# Web app launch
BUURT_BASE_URL=https://app.buurt-check.nl
BUURT_CORS_ORIGINS=["https://app.buurt-check.nl","https://buurt-check.nl"]

# Stripe / web monetization
BUURT_STRIPE_SECRET_KEY=
BUURT_STRIPE_WEBHOOK_SECRET=
BUURT_STRIPE_PRICE_CENTS=399

# Persistence
# Use Turso in production. Keep DATABASE_PATH only for local development.
BUURT_TURSO_DATABASE_URL=
BUURT_TURSO_AUTH_TOKEN=
BUURT_DATABASE_PATH=buurt_check.db

# Cache / resilience
BUURT_REDIS_URL=redis://localhost:6379

# Observability / controls
BUURT_SENTRY_DSN=
BUURT_SENTRY_ENVIRONMENT=production
BUURT_METRICS_ENABLED=false
BUURT_METRICS_TOKEN=
BUURT_RATE_LIMIT_ENABLED=true

# Google Play Billing (preserved for later Android release)
BUURT_GOOGLE_PLAY_ENABLED=false
BUURT_GOOGLE_PLAY_PACKAGE_NAME=
BUURT_GOOGLE_PLAY_PRODUCT_ID=full_dossier_unlock
BUURT_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
BUURT_GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=

# Apple App Store Billing (preserved for later iOS release)
BUURT_APPLE_ENABLED=false
BUURT_APPLE_BUNDLE_ID=nl.buurtcheck.app.ios
BUURT_APPLE_PRODUCT_ID=full_dossier_unlock
BUURT_APPLE_ENVIRONMENT=production
BUURT_APPLE_ISSUER_ID=
BUURT_APPLE_KEY_ID=
BUURT_APPLE_PRIVATE_KEY_FILE=
BUURT_APPLE_PRIVATE_KEY_PEM=
BUURT_APPLE_APP_STORE_ID=

# Optional forge3d server-side rendering
BUURT_FORGE3D_ENABLED=false

# Local webhook forwarding:
# stripe listen --forward-to localhost:8000/api/billing/webhook

