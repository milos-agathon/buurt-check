# Frontend observability
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=dev

# Pricing fallback before /api/pricing resolves
VITE_DOSSIER_PRICE_EUR=3.99

# Product contract:
# - `quick_brief` / "Quick checklist" remains free
# - `full_dossier` is paid before first download
# - the on-screen viewer remains free

# Deprecated preview toggles from the merchandising review period.
# They are not part of the supported product contract and should stay false
# outside temporary local experiments.
VITE_PREVIEW_DISABLE_PAYMENTS=false
VITE_PREVIEW_FORCE_FULL_DOSSIER_VIEW=false

# Sunlight analysis tuning
# Keep worker enabled unless debugging.
VITE_SUNLIGHT_USE_WORKER=true
# Explicit scene-level culling radius for sunlight occlusion checks.
VITE_SUNLIGHT_CULL_DISTANCE_METERS=120
# Number of roof points sampled for SVF averaging.
VITE_SVF_SAMPLE_POINTS=5

# PDF export request timeouts (ms)
# Full dossier can take substantially longer than quick brief on cold cache.
VITE_EXPORT_TIMEOUT_QUICK_MS=90000
VITE_EXPORT_TIMEOUT_FULL_MS=180000
